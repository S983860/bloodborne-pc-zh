// Bloodborne uses forward depth. The fsr4vk captured permutation accepts only
// reversed depth. Keep the game's depth attachment unchanged for gameplay,
// camera motion, DLSS and FSR3; convert only the FSR411 provider input.
#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform texture2D source_depth;
layout(binding=1,r32f) uniform writeonly image2D reversed_depth;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,imageSize(reversed_depth))))return;
    float d=texelFetch(source_depth,p,0).r;
    imageStore(reversed_depth,p,vec4(1.0-clamp(d,0.0,1.0)));
}
