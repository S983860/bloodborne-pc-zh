#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform accelerationStructureEXT scene;
layout(binding=1) uniform texture2D depth_tex;
layout(binding=2,rgba8) uniform image2D color_img;
layout(push_constant) uniform Parameters {
 vec4 inv_view[3];vec4 proj;vec4 viewport;uvec4 size_frame;vec4 ao_parameters;
};
vec3 position(ivec2 p){
 p=clamp(p,ivec2(0),ivec2(size_frame.xy)-1);
 float d=texelFetch(depth_tex,p,0).r;
 float z=proj.w/min(d-proj.z,-1e-8);
 vec2 ndc=((vec2(p)+.5-viewport.zw)/vec2(size_frame.xy))*2-1;
 vec4 v=vec4(ndc*z/proj.xy,z,1);
 return vec3(dot(inv_view[0],v),dot(inv_view[1],v),dot(inv_view[2],v));
}
uint hash(uint v){v^=v>>16;v*=0x7feb352du;v^=v>>15;v*=0x846ca68bu;return v^(v>>16);}
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,ivec2(size_frame.xy))))return;
 if(texelFetch(depth_tex,p,0).r>=1)return;
 vec3 w=position(p),dx=position(p+ivec2(1,0))-w,dy=position(p+ivec2(0,1))-w;
 vec3 n=cross(dx,dy);float len=length(n);if(len<1e-7||any(isnan(n)))return;n/=len;
 vec3 eye=vec3(inv_view[0].w,inv_view[1].w,inv_view[2].w);
 if(dot(n,eye-w)<0)n=-n;
 vec3 tangent=normalize(cross(n,abs(n.y)<.9?vec3(0,1,0):vec3(1,0,0)));
 vec3 bitangent=cross(n,tangent);
 uint seed=hash(uint(p.x)+uint(p.y)*size_frame.x+size_frame.z*1664525u);
 float angle=float(seed&65535u)*6.2831853/65536.;
 float visibility=0;
 uint samples=clamp(size_frame.w,1u,4u);
 for(uint r=0;r<samples;r++){
  float phi=angle+float(r)*2.3999632;
  vec3 dir=normalize(n*.7071068+(tangent*cos(phi)+bitangent*sin(phi))*.7071068);
  rayQueryEXT q;
  rayQueryInitializeEXT(q,scene,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,
                       255,w+n*.015,.005,dir,clamp(ao_parameters.x,.1,3.));
  while(rayQueryProceedEXT(q)){}
  visibility+=rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionNoneEXT?1.:0.;
 }
 vec4 color=imageLoad(color_img,p);
 color.rgb*=mix(1.-clamp(ao_parameters.y,0.,1.),1.,visibility/float(samples));
 imageStore(color_img,p,color);
}
